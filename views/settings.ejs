<%- include('partials/head') %>
<div id="canvas-particulas" class="fixed inset-0 pointer-events-none z-1"></div>
<%- include('partials/nav') %>

<div class="relative z-10 flex min-h-[calc(100vh-80px)] flex-col items-center justify-center px-2 py-8 text-center">
    <img src="/public/img/CuadroPerfilT.gif" alt="MarcoP" class="absolute inset-0 w-full h-full object-fill z-0 pointer-events-none">

    <h1 class="font-title3 mb-6 text-6xl text-white md:text-7xl z-10">Configuración</h1>

    <form action="/user/settings" method="POST" enctype="multipart/form-data" class="relative z-10 flex flex-col items-center gap-6 w-full max-w-3xl bg-black/75 border-2 border-[#332422] rounded-2xl p-8 md:p-12 shadow-2xl shadow-red-950/80 text-white">
        
        <!-- Vista previa circular de la foto actual o elegida -->
        <div class="flex flex-col items-center">
            <img id="avatarPreview" src="<%= avatar %>" alt="Avatar actual" class="w-36 h-36 md:w-44 md:h-44 rounded-full object-cover border-4 border-red-800 shadow-xl mb-4 bg-black/80">
            <p class="font-title3 text-[#C7C7C7] text-lg">Vista previa de tu foto de perfil</p>
        </div>

        <!-- Selector de archivo -->
        <div class="flex flex-col items-center w-full">
            <label for="avatarID" class="mb-3 text-3xl md:text-4xl text-white">Elegir nueva foto: </label>
            <input type="file" name="avatarFile" id="avatarID" accept="image/png, image/jpeg, image/gif" class="text-xl text-[#C7C7C7] file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-2 file:border-red-500/50 file:text-2xl file:text-white file:bg-black/40 hover:file:bg-[#610505] file:transition-all file:duration-100 file:cursor-pointer">
        </div>

        <!-- Cambiar nombre de usuario -->
        <div class="flex flex-col md:flex-row items-center justify-center gap-3 w-full">
            <label for="newUsernameID" class="text-3xl md:text-4xl text-white">Nuevo nombre: </label>
            <input type="text" name="newUsername" id="newUsernameID" placeholder="<%= user %>" class="px-4 py-2 rounded-lg text-2xl text-[#C7C7C7] bg-black/50 border-2 border-red-500/50 focus:outline-none focus:border-red-500 text-center">
        </div>

        <!-- Cambiar contraseña -->
        <div class="flex flex-col md:flex-row items-center justify-center gap-3 w-full">
            <label for="newPasswordID" class="text-3xl md:text-4xl text-white">Nueva clave: </label>
            <input type="password" name="newPassword" id="newPasswordID" class="px-4 py-2 rounded-lg text-2xl text-[#C7C7C7] bg-black/50 border-2 border-red-500/50 focus:outline-none focus:border-red-500 text-center">
        </div>

        <!-- Botones de Guardar y Cancelar -->
        <div class="flex flex-wrap justify-center gap-4 mt-4">
            <button type="submit" class="px-8 py-3 text-3xl text-white bg-black/50 border-2 border-red-500/50 rounded-xl transition-all duration-100 hover:scale-105 hover:bg-[#610505] cursor-pointer">
                Guardar Foto
            </button>
            <a href="/user" class="px-8 py-3 text-3xl text-[#C7C7C7] hover:text-white bg-black/30 border-2 border-[#332422] rounded-xl transition-all duration-100 hover:scale-105">
                Volver
            </a>
        </div>

    </form>
</div>

<!-- Script para actualizar la vista previa circular apenas elegís la foto -->
<script>
    const inputAvatar = document.getElementById('avatarID');
    const avatarPreview = document.getElementById('avatarPreview');

    inputAvatar.addEventListener('change', () => {
        if (inputAvatar.files && inputAvatar.files[0]) {
            avatarPreview.src = URL.createObjectURL(inputAvatar.files[0]);
        }
    });
</script>

<%- include('partials/foot') %>