<%- include('partials/head') %>
<div id="canvas-particulas" class="fixed inset-0 pointer-events-none z-1"></div>
<%- include('partials/nav') %>
<div class="flex min-h-[calc(100vh-80px)] flex-col items-center justify-center px-2 text-center">

    <form action="/signup" method="POST" class="w-full flex justify-center">
        <div class="relative z-10 flex flex-col items-center justify-center py-16 px-12 md:py-64 md:px-64 w-full max-w-[1080px]">
            <img src="/public/img/CuadroSesionG.gif" alt="Marco" class="absolute inset-0 w-full h-full object-fill -z-10 pointer-events-none">
            <!-- Contenedor interno limpio y alineado -->
            <div class="w-full max-w-md space-y-5 text-left">
            
            <!-- Titulo del formulario -->   
            <h1 class="font-title3 text-center mb-6 text-7xl text-[#c94a18] md:text-6xl z-10 drop-shadow-[0_2px_4px_rgba(0,0,0,0.9)]">Página de Registro</h1>
            
            <!-- Campo Nombre -->
            <div>
                <label for="usernameElementID" class="block text-xl md:text-2xl text-[#f4e8c1] font-title2 mb-1.5">
                Nombre de Usuario
                </label>
                <input 
                type="text"
                name="username" 
                id="usernameElementID" 
                placeholder="Ej. CondeDracula"
                required
                class="w-full px-4 py-2.5 text-lg md:text-xl text-[#f4e8c1] placeholder-[#8c7b70] bg-black/60 border-2 border-[#8b261d] rounded-md focus:outline-none focus:border-[#e86a17] focus:ring-1 focus:ring-[#e86a17] transition"
                >
            </div>

            <!-- Campo Email -->
            <div>
                <label for="emailElementID" class="block text-xl md:text-2xl text-[#f4e8c1] font-title2 mb-1.5">
                Correo Electrónico
                </label>
                <input 
                type="email" 
                name="email" 
                id="emailElementID" 
                placeholder="tu@correo.com"
                required
                class="w-full px-4 py-2.5 text-lg md:text-xl text-[#f4e8c1] placeholder-[#8c7b70] bg-black/60 border-2 border-[#8b261d] rounded-md focus:outline-none focus:border-[#e86a17] focus:ring-1 focus:ring-[#e86a17] transition"
                >
            </div>

            <!-- Campo Clave -->
            <div>
                <label for="passwordElementID" class="block text-xl md:text-2xl text-[#f4e8c1] font-title2 mb-1.5">
                Contraseña
                </label>
                <input 
                type="password" 
                name="password" 
                id="passwordElementID" 
                placeholder="••••••••"
                required
                class="w-full px-4 py-2.5 text-lg md:text-xl text-[#f4e8c1] placeholder-[#8c7b70] bg-black/60 border-2 border-[#8b261d] rounded-md focus:outline-none focus:border-[#e86a17] focus:ring-1 focus:ring-[#e86a17] transition"
                >
            </div>

            <!-- Botón de Registro -->
            <div class="pt-3">
                <button 
                type="submit" 
                class="w-full py-3 px-6 text-2xl md:text-3xl font-title2 text-[#fff8eb] bg-[#c94a18] hover:bg-[#e05822] border-2 border-[#f4e8c1]/40 rounded-md shadow-lg hover:shadow-[0_0_15px_rgba(232,106,23,0.6)] transition duration-200 cursor-pointer"
                >
                Registrarse
                </button>
            </div>

            <!-- Enlace a Login (opcional) -->
            <div class="text-center pt-2 text-base md:text-lg text-[#d6c7b2]">
                ¿Ya tienes cuenta? 
                <a href="/login" class="text-[#ff8c38] hover:text-[#ffb074] underline underline-offset-4 font-title2">
                Inicia sesión
                </a>
            </div>

            </div>
        </div>
    </form>
</div>
<%- include('partials/foot') %>