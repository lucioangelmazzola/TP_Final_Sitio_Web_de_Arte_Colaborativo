<!-- Cuadrícula de miniaturas -->
<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
    <!-- Recorre todas las imagenes del usuario -->
    <% for (let img of locals.images) { %>
        <!-- Clic para imagen completa -->
        <div onclick="abrirImagen('<%= img %>')" class="group relative overflow-hidden rounded-xl border-2 border-red-900/70 bg-black/80 p-3 shadow-xl shadow-red-950/60 transition-all duration-200 hover:border-red-500 cursor-pointer">
            <!-- Marco que recorta al hacer zoom -->
            <div class="overflow-hidden rounded-lg">
                <!-- Imagen chica con efecto de agrandado al pasar el mouse -->
                <img src="<%= img %>" alt="imagen de usuario" class="w-full h-64 object-cover transition-transform duration-300 group-hover:scale-105">
            </div>
        </div>
    <% } %>
</div>

<!-- Visor en pantalla completa -->
<div id="modalImagen" onclick="cerrarImagen()" class="hidden fixed inset-0 z-50 bg-black/90 flex flex-col items-center justify-center p-4 cursor-pointer">

    <!-- Imagen completa -->
    <img id="imagenGrande" src="" alt="Vista completa" onclick="event.stopPropagation()" class="max-w-full max-h-[80vh] object-contain rounded-xl border-2 border-red-700 shadow-2xl shadow-red-950 cursor-default">
</div>

<script>
    // Guarda las referencias del contenedor modal y de la imagen ampliada
    const modal = document.getElementById('modalImagen');
    const imagenGrande = document.getElementById('imagenGrande');

    // Carga la ruta de la foto elegida y hace visible el visor
    function abrirImagen(ruta) {
        imagenGrande.src = ruta;
        modal.classList.remove('hidden');
    }

    // Vuelve a ocultar el visor y limpia la imagen cargada
    function cerrarImagen() {
        modal.classList.add('hidden');
        imagenGrande.src = '';
    }

    // También se cierra al apretar la tecla Escape
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') cerrarImagen();
    });
</script>